# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public key. Use the anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Apply all SQL migrations in supabase/migrations/ in filename order through 20240101000116_appointment_status_email_details.sql.
# Local origin for auth redirects. In production, set NEXT_PUBLIC_SITE_URL to the
# public HTTPS origin, with no path, query, or fragment. Vercel can supply
# NEXT_PUBLIC_VERCEL_URL when NEXT_PUBLIC_SITE_URL is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public HTTPS storefront origin for welcome and order status links.
# Set this to your deployed storefront origin when sending emails from local development.
CUSTOMER_EMAIL_SITE_URL=

# Server-only chat guest recovery
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPPORT_CHAT_RECOVERY_SECRET=replace-with-a-random-secret-at-least-32-characters
# Brevo sends guest chat recovery codes and one-time customer welcome emails.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com

# Server-only SMS Gate Cloud API credentials
SMS_GATEWAY_USERNAME=your-sms-gateway-username
SMS_GATEWAY_PASSWORD=your-sms-gateway-password
PHONE_VERIFICATION_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters

# Playwright accounts. Use a confirmed customer with a completed order and PDFs.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
